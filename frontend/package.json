{
  "name": "webapp-portfolio",
  "version": "2.0.3",
  "type": "module",
  "private": true,
  "scripts": {
    "clean": "make clean",
    "generate": "nuxt generate",
    "postinstall": "nuxt prepare",
    "pre-release": "npm run test",
    "test:nuxt": "vitest run tests/nuxt",
    "dev": "tinacms dev -c \"nuxt dev\"",
    "build": "tinacms build && nuxt build",
    "serve": "npm run build && nuxt preview",
    "test": "vitest run && npm run test:sass",
    "test:dev": "vitest run --reporter=verbose && npm run test:sass",
    "test:sass": "sass --pkg-importer=node sass/tests/index.spec.sass sass/tests/output/output.spec.css && npx tsx sass/tests/ts/dependency-warnings.ts && npx tsx sass/tests/ts/syntax-check.ts",
    "deploy": "npm run test && npm run build && npm run generate && netlify deploy --dir=.output/public --no-build --prod --message='Se_CHANGELOG.md_for_forbedringer_og_endringer'"
  },
  "dependencies": {
    "@nuxt/content": "^3.1.0",
    "@nuxt/eslint": "^1.1.0",
    "@nuxt/image": "^1.8.0",
    "@nuxt/ui": "^2.21.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "better-sqlite3": "^11.8.0",
    "bootstrap-icons": "^1.11.0",
    "eslint": "^9.18.0",
    "lumina-sass": "^3.3.0",
    "nuxt": "^3.15.0",
    "nuxt-gtag": "^3.0.0",
    "tinacms": "^2.2.0"
  },
  "devDependencies": {
    "@nuxt/fonts": "^0.10.0",
    "@nuxt/test-utils": "^3.15.0",
    "@nuxtjs/sitemap": "^6.0.0",
    "@pinia/nuxt": "^0.10.0",
    "@tinacms/cli": "^1.6.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.0.0",
    "@vue/test-utils": "^2.4.6",
    "conventional-changelog": "^6.0.0",
    "jsdom": "^26.0.0",
    "netlify-cli": "^17.35.0",
    "patch-package": "^8.0.0",
    "pinia": "^2.3.0",
    "postinstall-postinstall": "^2.1.0",
    "sass": "^1.83.0",
    "sass-true": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "vitest-axe": "^0.1.0"
  },
  "config": {
    "legacy-peer-deps": true
  },
  "allowScripts": {
    "better-sqlite3": true
  }
}
