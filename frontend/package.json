{
  "name": "webapp-portfolio",
  "version": "2.0.3",
  "type": "module",
  "private": true,
  "scripts": {
    "clean": "make clean",
    "generate": "nuxt generate",
    "postinstall": "nuxt prepare",
    "pre-release": "npm run test",
    "test:nuxt": "vitest run tests/nuxt",
    "dev": "tinacms dev -c \"nuxt dev\"",
    "build": "tinacms build && nuxt build",
    "serve": "npm run build && nuxt preview",
    "test": "vitest run && npm run test:sass",
    "test:dev": "vitest run --reporter=verbose && npm run test:sass",
    "test:sass": "sass --pkg-importer=node sass/tests/index.spec.sass sass/tests/output/output.spec.css && npx tsx sass/tests/ts/dependency-warnings.ts && npx tsx sass/tests/ts/syntax-check.ts"
  },
  "dependencies": {
    "@nuxt/content": "^3.15.0",
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/image": "^1.11.0",
    "@nuxt/ui": "^2.22.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/devtools-api": "^8.2.1",
    "better-sqlite3": "^11.10.0",
    "bootstrap-icons": "^1.13.0",
    "eslint": "^9.39.0",
    "lumina-sass": "^3.3.5",
    "nuxt": "^4.5.0",
    "nuxt-gtag": "^3.0.0",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "tinacms": "^2.10.0"
  },
  "devDependencies": {
    "@nuxt/fonts": "^0.10.0",
    "@nuxt/test-utils": "^3.15.0",
    "@nuxtjs/sitemap": "^8.3.2",
    "@pinia/nuxt": "^1.0.1",
    "@tinacms/cli": "^1.6.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.0",
    "@vue/test-utils": "^2.4.6",
    "conventional-changelog": "^6.0.0",
    "jsdom": "^26.0.0",
    "patch-package": "^8.0.0",
    "pinia": "^4.0.2",
    "postinstall-postinstall": "^2.1.0",
    "sass": "^1.102.0",
    "sass-true": "^8.1.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "vitest-axe": "^0.1.0"
  },
  "config": {
    "legacy-peer-deps": true
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/changelog",
        {
          "changelogFile": "CHANGELOG.md"
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": ["CHANGELOG.md"],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ],
      "@semantic-release/github"
    ]
  },
  "allowScripts": {
    "better-sqlite3": true
  }
}
